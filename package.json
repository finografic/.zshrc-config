{
  "name": "zshrc-config",
  "description": "Superior ZSH configuration and startup, supporting multiple dynamic hosts and environments.",
  "version": "0.3.1",
  "license": "MIT",
  "author": "Justin Rankin",
  "private": true,
  "type": "module",
  "scripts": {
    "install:globals": "npm i -g fd-find vtop",
    "·········· ZCONF": "·····················································",
    "zconf": "pnpm -C packages/zconf dev",
    "zconf:build": "pnpm -C packages/zconf build",
    "doctor": "pnpm -C packages/zconf dev doctor",
    "scan": "pnpm -C packages/zconf dev scan",
    "test": "pnpm -C packages/zconf test",
    "typecheck": "pnpm -C packages/zconf typecheck",
    "·········· LINTING": "···················································",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:md": "md-lint",
    "lint:md:fix": "md-lint --fix",
    "lint:ci": "oxlint --quiet",
    "·········· FORMATTING": "················································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "·········· RELEASE:GITHUB": "············································",
    "release:github:patch": "pnpm run release:check && pnpm version patch && git push --follow-tags",
    "release:github:minor": "pnpm run release:check && pnpm version minor && git push --follow-tags",
    "release:github:major": "pnpm run release:check && pnpm version major && git push --follow-tags",
    "release:check": "pnpm lint:fix && pnpm format:check && pnpm typecheck && pnpm test",
    "·········· UTILS": "·····················································",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "^2.4.2",
    "git-branch-select": "^4.1.0",
    "jmate": "^0.0.3",
    "ora": "^4.1.1",
    "pfetch": "0.0.0-reserved"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@finografic/md-lint": "^0.16.6",
    "@finografic/oxc-config": "^2.8.2",
    "husky": "latest",
    "lint-staged": "latest",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "tsx": "^4.21.0"
  },
  "packageManager": "pnpm@10.28.2",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern --ignore-pattern 'package-types/**'"
    ],
    "*.md": [
      "oxfmt --no-error-on-unmatched-pattern",
      "md-lint --fix"
    ],
    "*.{json,jsonc,yml,yaml,toml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
