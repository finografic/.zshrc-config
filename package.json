{
  "name": "zshrc-config",
  "description": "Superior ZSH configuration and startup, supporting multiple dynamic hosts and environments.",
  "license": "MIT",
  "author": "Justin Rankin",
  "private": true,
  "scripts": {
    "install:globals": "npm i -g fd-find vtop",
    "·········· LINTING": "···················································",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "lint:ci": "oxlint -c oxlint.config.ts --quiet",
    "lint:md": "md-lint",
    "lint:md:fix": "md-lint --fix",
    "·········· FORMATTING": "················································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "·········· NODE": "··················································",
    "build:node": "pnpm --filter @zshrc/node build",
    "typecheck:node": "pnpm --filter @zshrc/node typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "^2.4.2",
    "git-branch-select": "^4.1.0",
    "jmate": "^0.0.3",
    "ora": "^4.1.1",
    "pfetch": "0.0.0-reserved"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@finografic/md-lint": "^0.16.6",
    "@finografic/oxc-config": "^2.8.2",
    "husky": "latest",
    "lint-staged": "latest",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "tsx": "^4.21.0"
  },
  "packageManager": "pnpm@10.28.2",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern --ignore-pattern 'package-types/**'"
    ],
    "*.md": [
      "oxfmt --no-error-on-unmatched-pattern",
      "md-lint --fix"
    ],
    "*.{json,jsonc,yml,yaml,toml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
