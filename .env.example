IS_HOME=
IS_OFFICE=
IS_SERVER=

NPM_TOKEN=

# Remote server SSH target, used by the rsync/deploy helpers.
# SERVER_SSH_KEY is the PRIVATE key (no .pub suffix).
SERVER_SSH_HOST=
SERVER_SSH_ROOT_USER=root
SERVER_SSH_USER=
SERVER_SSH_PORT=22
SERVER_SSH_KEY="$HOME/.ssh/id_rsa"

# Optional second host for the jmate/remote-vscode tunnel helper.
TUNNEL_SSH_HOST=
TUNNEL_SSH_USER=
TUNNEL_SSH_PORT=22

# Static-site deploy target used by `deploy-static` (lib/dev.zsh).
DEPLOY_SSH_TARGET=
DEPLOY_SSH_PORT=22
DEPLOY_SITE=
DEPLOY_REMOTE_ROOT=/var/www

# LAN SMB share used by `mount-nas`. Never put the password here — omit it and
# mount_smbfs will prompt, or store it in the macOS Keychain.
NAS_HOST=
NAS_SHARE=
NAS_USER=

typeset -gA REPO_ALIASES=(
  [skills]="$HOME/ai-agent-skills"
  [repos]="$HOME/repos"
  [next]="$HOME/repos-next"
)
