{
  "name": "zshrc-config",
  "description": "Superior ZSH configuration and startup, supporting multiple dynamic hosts and environments.",
  "scripts": {
    "install:globals": "npm i -g fd-find vtop",
    "·········· FORMATTING": "··················································",
    "format": "dprint fmt --diff",
    "format.check": "dprint check",
    "·········· NODE": "··················································",
    "build:node": "pnpm --filter @zshrc/node build",
    "typecheck:node": "pnpm --filter @zshrc/node typecheck"
  },
  "dependencies": {
    "chalk": "^2.4.2",
    "git-branch-select": "^4.1.0",
    "jmate": "^0.0.3",
    "ora": "^4.1.1",
    "pfetch": "0.0.0-reserved"
  },
  "devDependencies": {
    "eslint-plugin-markdownlint": "^0.9.0",
    "tsx": "^4.21.0"
  },
  "packageManager": "pnpm@10.28.2"
}
