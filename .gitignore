# COMMON IGNORE RULES #
# https://help.github.com/articles/ignoring-files/

# Dependencies (recursive - root and any workspace)
**/node_modules/

# Build outputs
dist/
!packages/node/dist/
build/

# Environment files
.env
.env.local
.env.*.local

# antidote generates new version on intialisation
.zsh_plugins.generated.zsh

# IDE
.cursor/
!.cursor/rules/
.idea/
*.swp
*.swo

# Compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases
*.sql
*.sqlite
djay_icloud_sync.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# OS
.DS_Store
.DS_Store?
*.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
